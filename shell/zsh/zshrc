# Zsh-specific settings
setopt AUTO_CD              # cd by typing directory name if it's not a command
setopt CORRECT_ALL          # autocorrect commands
setopt AUTO_LIST            # automatically list choices on ambiguous completion
setopt AUTO_MENU            # automatically use menu completion
setopt ALWAYS_TO_END        # move cursor to end if word had one match
setopt HIST_VERIFY          # show command with history expansion to user before running it
setopt SHARE_HISTORY        # share command history data
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

HISTFILE="$HOME/.zsh_history"

# Disable "You have new mail." notice (triggered by /var/mail/$USER)
unset MAIL MAILPATH
MAILCHECK=0

# Zsh completions: full compinit (with security audit) at most once per 24h,
# otherwise trust the dump (-C). (#q...) glob qualifiers need EXTENDED_GLOB;
# scope it locally — enabling it globally breaks args like `git show HEAD^`.
autoload -Uz compinit
() {
  setopt localoptions extendedglob
  if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
    touch ~/.zcompdump   # full run may not rewrite the dump; reset the 24h clock
  else
    compinit -C
  fi
}

# Case insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

export OTEL_CONFIG_DIR="$HOME/.claude"

zmodload zsh/datetime

# Sync OBTOOL API key (throttled to once per hour)
_STAMP="$OTEL_CONFIG_DIR/.sync-obtool-key.stamp"
_SYNC_SCRIPT="$OTEL_CONFIG_DIR/scripts/otel/sync-obtool-key.sh"
_STAMP_MTIME=$(stat -f%m "$_STAMP" 2>/dev/null || stat -c%Y "$_STAMP" 2>/dev/null) || _STAMP_MTIME=0
if (( EPOCHSECONDS - _STAMP_MTIME > 3600 )) && [[ -x "$_SYNC_SCRIPT" ]]; then
  "$_SYNC_SCRIPT" 2>/dev/null && touch "$_STAMP"
fi
unset _STAMP _STAMP_MTIME _SYNC_SCRIPT

## [Completion]
## Completion scripts setup. Remove the following line to uninstall
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && builtin source "$HOME/.dart-cli-completion/zsh-config.zsh" || true
## [/Completion]

[ -f ~/.fzf.zsh ] && builtin source ~/.fzf.zsh

# Load zsh prompt customization (from the repo, matching bashrc)
[[ -f "$SHELL_DIR/zsh/prompt.zsh" ]] && source "$SHELL_DIR/zsh/prompt.zsh"

# Drop stale /opt/pmk path entries
path=(${path:#/opt/pmk*})

# Re-alias our Doppler GITHUB_TOKEN to the name the upstream github MCP plugin requires.
export GITHUB_PERSONAL_ACCESS_TOKEN="${GITHUB_PERSONAL_ACCESS_TOKEN:-$(secret GITHUB_TOKEN 2>/dev/null || gh auth token 2>/dev/null)}"

# Hugging Face Hub token from Doppler (silences huggingface_hub auth warnings).
export HF_TOKEN="${HF_TOKEN:-$(secret HF_TOKEN 2>/dev/null)}"

# Re-lay the repo's PATH entries. common.sh ran at zshenv time, before
# /etc/zprofile's path_helper hoisted /etc/paths to the front and demoted all of
# them below /usr/bin. _path_prepend now forces position, so re-running the same
# function restores the intended order rather than no-oping on "already present".
# Ascending priority is defined once, in common.sh — not duplicated here.
_dotfiles_hoist_path

# Hoist Homebrew: path_helper demotes /opt/homebrew/bin below /usr/bin the same
# way it demotes the pyenv shims below, leaving Apple's /usr/bin/git stub first.
# That stub is a re-exec wrapper and costs ~8ms to start against ~3ms for the
# real binary, which every git-spawning hook pays. bash_profile already does
# this; zsh was the gap.
#
# Must precede the pyenv re-hoist: brew ships its own python3, so prepending
# Homebrew after pyenv would shadow the shims — and this machine needs
# pyenv-built pythons (brew's are broken by the libexpat ABI on macOS 26).
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Re-hoist pyenv shims: common.sh prepends them at zshenv time, but on macOS
# login shells /etc/zprofile's path_helper demotes them below /usr/bin.
# Re-run the cached init (falls back to a live init if the cache is absent).
if command -v pyenv >/dev/null 2>&1; then
  source "${DOTFILES_CACHE_DIR:-$HOME/.cache/dotfiles}/pyenv-init.zsh.sh" 2>/dev/null \
    || eval "$(pyenv init -)"
fi

# direnv hook
eval "$(direnv hook zsh)"
