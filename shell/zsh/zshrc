# Zsh-specific settings
setopt AUTO_CD              # cd by typing directory name if it's not a command
setopt CORRECT_ALL          # autocorrect commands
setopt AUTO_LIST            # automatically list choices on ambiguous completion
setopt AUTO_MENU            # automatically use menu completion
setopt ALWAYS_TO_END        # move cursor to end if word had one match
setopt HIST_VERIFY          # show command with history expansion to user before running it
setopt SHARE_HISTORY        # share command history data
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

HISTFILE="$HOME/.zsh_history"

# Disable "You have new mail." notice (triggered by /var/mail/$USER)
unset MAIL MAILPATH
MAILCHECK=0

# Zsh completions: full compinit (with security audit) at most once per 24h,
# otherwise trust the dump (-C). (#q...) glob qualifiers need EXTENDED_GLOB;
# scope it locally — enabling it globally breaks args like `git show HEAD^`.
autoload -Uz compinit
() {
  setopt localoptions extendedglob
  if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
    touch ~/.zcompdump   # full run may not rewrite the dump; reset the 24h clock
  else
    compinit -C
  fi
}

# Case insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

export OTEL_CONFIG_DIR="$HOME/.claude"

# OTLP ingest endpoint for the detached telemetry shipper (hooks/lib/span-shipper.ts).
# Set here, unconditionally, because neither of the other two sources reaches the
# hook processes that actually ship: settings.json `env` does not propagate to them,
# and ~/.claude/.envrc only applies under directories direnv has loaded. Without it
# shipTelemetry short-circuits to `outcome: "no-endpoint"` and writes nothing --
# silently, because metrics are the only signal that depends on it (the MCP server
# exports its own spans and logs inline, so a dead shipper still looks healthy).
# Static, non-secret value: auth is separate and already satisfied by OBTOOL_API_KEY,
# which hasOtlpAuth() accepts on its own, so no credential belongs in this file.
# Stalled 2026-07-27 -> 08-01 this way; ~159 MB of metrics went unshipped.
export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT:-https://ingest.integritystudio.ai}"

zmodload zsh/datetime

# Sync OBTOOL API key (throttled to once per hour)
_STAMP="$OTEL_CONFIG_DIR/.sync-obtool-key.stamp"
_SYNC_SCRIPT="$OTEL_CONFIG_DIR/scripts/otel/sync-obtool-key.sh"
_STAMP_MTIME=$(stat -f%m "$_STAMP" 2>/dev/null || stat -c%Y "$_STAMP" 2>/dev/null) || _STAMP_MTIME=0
if (( EPOCHSECONDS - _STAMP_MTIME > 3600 )) && [[ -x "$_SYNC_SCRIPT" ]]; then
  "$_SYNC_SCRIPT" 2>/dev/null && touch "$_STAMP"
fi
unset _STAMP _STAMP_MTIME _SYNC_SCRIPT

## [Completion]
## Completion scripts setup. Remove the following line to uninstall
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && builtin source "$HOME/.dart-cli-completion/zsh-config.zsh" || true
## [/Completion]

[ -f ~/.fzf.zsh ] && builtin source ~/.fzf.zsh

# Load zsh prompt customization (from the repo, matching bashrc)
[[ -f "$SHELL_DIR/zsh/prompt.zsh" ]] && source "$SHELL_DIR/zsh/prompt.zsh"

# Drop stale /opt/pmk path entries
path=(${path:#/opt/pmk*})

# Warm the Doppler cache once, in THIS shell, before the two reads below.
# `secret` populates it lazily, but each $(...) below is a subshell: the fetch
# would happen inside the fork and die with it, so both reads would pay their own
# network round-trip and the parent would still hold nothing. One call here keeps
# an interactive shell at exactly one fetch — the same as the old eager load —
# while non-interactive shells, which never reach zshrc, pay none.
_doppler_ensure_cache

# Re-alias our Doppler GITHUB_TOKEN to the name the upstream github MCP plugin requires.
export GITHUB_PERSONAL_ACCESS_TOKEN="${GITHUB_PERSONAL_ACCESS_TOKEN:-$(secret GITHUB_TOKEN 2>/dev/null || gh auth token 2>/dev/null)}"

# Hugging Face Hub token from Doppler (silences huggingface_hub auth warnings).
export HF_TOKEN="${HF_TOKEN:-$(secret HF_TOKEN 2>/dev/null)}"

# AgentMail API key from Doppler.
export AGENTMAIL_API_KEY="${AGENTMAIL_API_KEY:-$(secret AGENTMAIL_API_KEY 2>/dev/null)}"

# LLM-as-Judge key from Doppler. Deliberately NOT exported as ANTHROPIC_API_KEY:
# that name is also read by Claude Code itself, and setting it would switch the
# CLI off its subscription login onto API-key billing. The quality-evaluation
# hook reads this name first (hooks/handlers/stop-quality-evaluation.ts).
export LLM_JUDGE_ANTHROPIC_KEY="${LLM_JUDGE_ANTHROPIC_KEY:-$(secret LLM_JUDGE_ANTHROPIC_KEY 2>/dev/null)}"

# xAI key from Doppler, for the LLM-as-Judge cross-family arm (AA3 Gate 3b:
# does a judge sharing the primary model's family still detect bad output?).
# Unprefixed name is safe here — nothing else in this environment reads it — and
# the judge accepts LLM_JUDGE_XAI_KEY first if you ever need to scope it.
# Hooks are spawned per event and inherit only the shell env, so this must be
# exported before the CLI starts; settings.json `env` does not reach hooks.
export XAI_API_KEY="${XAI_API_KEY:-$(secret XAI_API_KEY 2>/dev/null)}"

# AA3 Gate 3b collection: all meta-eval arms from one session population.
# Same-family arm = the primary judge's model; cross-family arms = grok-4.3
# (5.1s vs grok-4.6's 18.3s inside a Stop hook) and gpt-5.4-mini (key: Doppler
# OPEN_AI_KEY, project LLM_MULTI_ARM_JUDGE_KEY). Rate 1 meta-evaluates every
# judged score (~0.3 explanation_quality records/session vs 0.03 at the 0.1
# default). Unset both to stop collecting. Read at hook spawn: restart the CLI.
export META_EVAL_JUDGE_MODELS="${META_EVAL_JUDGE_MODELS:-claude-haiku-4-5-20251001,grok-4.3,gpt-5.4-mini}"
export META_EVAL_SAMPLE_RATE="${META_EVAL_SAMPLE_RATE:-1}"

# Keep $path unique. zsh ties it to $PATH and, on a duplicate, keeps the FIRST
# occurrence — so this both dedupes and preserves priority. It is a safety net,
# not the mechanism: _path_prepend still removes before prepending, because
# common.sh is shared with bash, which has no equivalent. Applies to everything
# added after this point too, including pyenv init and direnv below.
typeset -U path

# PATH repair moved to zsh/zprofile — path_helper only runs for login shells, so
# that is where the damage happens and the first place that can undo it.
#
# The pyenv re-hoist that used to sit here went with it, and is not replaced:
# _dotfiles_hoist_path already puts $PYENV_ROOT/shims at the front, which was the
# only thing that block achieved. `pyenv init` itself still runs once at zshenv
# time via common.sh, so the pyenv shell function and PYENV_SHELL are unaffected.

# No direnv hook here: common.sh already installs it for whichever shell is
# running. direnv guards against double registration, so the second eval only
# ever cost an extra subprocess per shell start — but it read as though one of
# the two were load-bearing.
