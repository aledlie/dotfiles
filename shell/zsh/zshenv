# Zsh environment — sourced for all zsh invocations (login, interactive, scripts)
# Locate the repo by resolving this file's own symlink. install.sh symlinks
# ~/.zshenv -> $DOTFILES_DIR/shell/zsh/zshenv; the :A modifier resolves that
# link to the real path, so the repo works from any clone location. Falls back
# to ~/dotfiles only if this file was copied rather than symlinked.
() {
  local self="${${(%):-%x}:A}"
  if [[ "$self" == */shell/zsh/zshenv ]]; then
    export DOTFILES_DIR="${DOTFILES_DIR:-${self:h:h:h}}"
  else
    export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
  fi
}
export SHELL_DIR="$DOTFILES_DIR/shell"

# Platform detection lives in install.sh (detect_arch/detect_ostype); at runtime
# common.sh sets $PLATFORM, the only platform variable the shell config consumes.

# Load common shell configuration shared with bash
[[ -f "$SHELL_DIR/common.sh" ]] && source "$SHELL_DIR/common.sh"
