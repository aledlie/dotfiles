# Ignore sensitive files
.env
.env.local
.env.*.local

# Ignore backup files
*.backup.*
*~
.*.swp
.*.swo

# Ignore OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore vim runtime state
vim/viminfo
# vim/plugin/ is managed exclusively by vim-plug (not git submodules)
vim/plugin/

# Ignore temporary files
*.tmp
*.temp
/tmp/

# Ignore local customizations
*.local
local/
